{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification contract",
  "description": "Proposed requirements, checks, evidence types, and maturity gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "contract_version", "title", "requirements"],
  "properties": {
    "schema_version": { "const": "0.3.0" },
    "contract_id": { "$ref": "#/$defs/identifier" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "extensions": { "$ref": "#/$defs/extensions" },
    "production_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "integration", "operations", "evaluation"],
      "properties": {
        "security": {
          "allOf": [
            { "$ref": "#/$defs/production_control" },
            { "properties": { "applicability": { "const": "required" } } }
          ]
        },
        "integration": { "$ref": "#/$defs/production_control" },
        "operations": { "$ref": "#/$defs/production_control" },
        "evaluation": { "$ref": "#/$defs/production_control" }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
    "extensions": {
      "description": "Supplementary producer metadata; it cannot change contract semantics.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
      "additionalProperties": { "type": "object" }
    },
    "production_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability"],
      "properties": {
        "applicability": { "enum": ["required", "not_applicable"] },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "reference"],
          "properties": {
            "reviewer": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "reference": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "applicability": { "const": "not_applicable" } } },
          "then": { "required": ["reason", "review"] }
        }
      ]
    },
    "gate": { "enum": ["blocking", "non_blocking", "not_applicable"] },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "procedure", "evidence_types", "evidence_max_age_seconds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "method": {
          "enum": ["unit", "contract", "integration", "e2e", "agent_evaluation", "security", "smoke", "manual"]
        },
        "procedure": { "type": "string", "minLength": 1 },
        "evidence_max_age_seconds": { "type": "integer", "minimum": 1 },
        "evidence_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["test_report", "evaluation_result", "trace", "approval_record", "human_review", "security_report", "other"]
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "success_criteria",
        "failure_criteria",
        "critical",
        "security_critical",
        "domains",
        "checks",
        "gates"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "statement": { "type": "string", "minLength": 1 },
        "success_criteria": { "type": "string", "minLength": 1 },
        "failure_criteria": { "type": "string", "minLength": 1 },
        "critical": { "type": "boolean" },
        "security_critical": { "type": "boolean" },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["functional", "security", "integration", "operations", "evaluation"] }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/check" }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prototype", "production_candidate", "customer_validated"],
          "properties": {
            "prototype": { "$ref": "#/$defs/gate" },
            "production_candidate": { "$ref": "#/$defs/gate" },
            "customer_validated": { "$ref": "#/$defs/gate" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "security_critical": { "const": true } } },
          "then": {
            "properties": {
              "critical": { "const": true },
              "domains": { "contains": { "const": "security" } }
            }
          }
        },
        {
          "if": { "properties": { "critical": { "const": true } } },
          "then": {
            "properties": {
              "gates": {
                "properties": {
                  "prototype": { "enum": ["blocking", "not_applicable"] },
                  "production_candidate": { "enum": ["blocking", "not_applicable"] },
                  "customer_validated": { "enum": ["blocking", "not_applicable"] }
                }
              }
            }
          }
        }
      ]
    }
  }
}
