{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independently administered readiness trust store",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_sha256", "keys"],
  "properties": {
    "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reviewer", "public_key", "roles"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
          "reviewer": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "public_key": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "roles": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["contract", "risk", "applicability", "classification", "customer", "result"]}
          },
          "revoked_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
