{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Readiness report",
  "description": "Proposed evidence-bearing results for one contract and maturity target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "contract_sha256",
    "source_revision",
    "environment",
    "assessed_at",
    "target_maturity",
    "gate_status",
    "results"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "contract_id": { "$ref": "#/$defs/identifier" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_revision": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "environment": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "assessed_at": { "type": "string", "format": "date-time" },
    "target_maturity": { "enum": ["prototype", "production_candidate", "customer_validated"] },
    "gate_status": { "enum": ["passed", "failed", "unverified"] },
    "extensions": { "$ref": "#/$defs/extensions" },
    "results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/result" }
    },
    "contract_approval": { "$ref": "#/$defs/approval" },
    "customer_approval": { "$ref": "#/$defs/approval" }
  },
  "allOf": [
    {
      "if": { "properties": { "gate_status": { "const": "passed" } } },
      "then": {
        "required": ["contract_approval"],
        "properties": {
          "contract_approval": {
            "properties": { "decision": { "const": "approved" } }
          },
          "results": {
            "contains": {
              "properties": {
                "gate": { "const": "blocking" },
                "status": { "const": "passed" }
              },
              "required": ["gate", "status"]
            },
            "items": {
              "properties": { "status": { "enum": ["passed", "not_applicable"] } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_maturity": { "const": "customer_validated" },
          "gate_status": { "const": "passed" }
        },
        "required": ["target_maturity", "gate_status"]
      },
      "then": {
        "required": ["customer_approval"],
        "properties": {
          "customer_approval": {
            "properties": { "decision": { "const": "approved" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reviewer", "reference", "decided_at"],
      "properties": {
        "decision": { "enum": ["approved", "rejected"] },
        "reviewer": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "reference": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    },
    "extensions": {
      "description": "Supplementary producer metadata; it cannot change readiness semantics.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
      "additionalProperties": { "type": "object" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "revision", "environment", "recorded_at", "sha256"],
      "properties": {
        "kind": {
          "enum": ["test_report", "evaluation_result", "trace", "approval_record", "human_review", "security_report", "other"]
        },
        "reference": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "revision": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "environment": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "outcome"],
      "properties": {
        "check_id": { "$ref": "#/$defs/identifier" },
        "outcome": { "enum": ["passed", "failed", "unverified"] },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "passed" } } },
          "then": { "required": ["evidence"] },
          "else": { "required": ["reason"] }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "gate", "status"],
      "properties": {
        "requirement_id": { "$ref": "#/$defs/identifier" },
        "gate": { "enum": ["blocking", "non_blocking", "not_applicable"] },
        "status": { "enum": ["passed", "failed", "unverified", "not_applicable"] },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "implementation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "check_results": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/check_result" }
        },
        "applicability_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "reference"],
          "properties": {
            "reviewer": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "reference": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "passed" } } },
          "then": {
            "required": ["check_results"],
            "properties": {
              "check_results": {
                "items": { "properties": { "outcome": { "const": "passed" } } }
              }
            }
          },
          "else": { "required": ["reason"] }
        },
        {
          "if": { "properties": { "gate": { "const": "not_applicable" } } },
          "then": {
            "properties": { "status": { "enum": ["not_applicable", "unverified"] } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "not_applicable" } } },
          "then": {
            "required": ["applicability_review"],
            "properties": { "gate": { "const": "not_applicable" } }
          }
        }
      ]
    }
  }
}
