        "ORS-001",
        "ORS-002",
        "ORS-003"
      ],
      "check_ids": [
        "ORDER-RESOLUTION-TECHNICAL-EXECUTION",
        "ORDER-RESOLUTION-BUSINESS-OUTCOME"
      ],
      "expected_output": {
        "scenario_ids": [
          "ORS-001",
          "ORS-002",
          "ORS-003"
        ],
        "technical_execution": {
          "ORS-001": {
            "native_checkpoint": "not_required",
            "action_count": 1,
            "terminal_state": "completed"
          },
          "ORS-002": {
            "native_checkpoint": "pause_before_action",
            "decision_count": 1,
            "action_count": 1,
            "terminal_state": "completed"
          },
          "ORS-003": {
            "native_checkpoint": "pause_before_action",
            "decision": "rejected",
            "action_count": 0,
            "terminal_state": "escalated"
          }
        },
        "business_outcome": {
          "ORS-001": {
            "action": "partial_refund_10",
            "amount": "USD 7.90",
            "approval_required": false
          },
          "ORS-002": {
            "action": "partial_refund_10",
            "amount": "USD 18.50",
            "approval_required": true
          },
          "ORS-003": {
            "action": "replacement_shipment",
            "approval_required": true,
            "decision": "rejected"
          }
        }
      }
    },
    {
