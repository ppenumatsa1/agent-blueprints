{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: sync locked dependencies",
      "type": "process",
      "command": "uv",
      "args": ["sync", "--locked"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: lint and format check",
      "dependsOn": ["Backend: Ruff lint", "Backend: Ruff format check"],
      "problemMatcher": []
    },
    {
      "label": "Backend: Ruff lint",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "ruff", "check", "."],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: Ruff format check",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "ruff", "format", "--check", "."],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev server",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": { "activeOnStart": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    }
  ]
}
