{
  "name": "maf-workflow-blueprint-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
